      </column>
      <column caption='YOY Quantity%' datatype='real' name='[Calculation_873909442462609409 1 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_873909442455048192 3]-[Calculation_873909442455048192 1 2])/[Calculation_873909442455048192 1 2]' />
      </column>
      <column caption='YOY Profit%' datatype='real' name='[Calculation_873909442462609409 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_873909442455048192 2]-[Calculation_873909442455048192 1 1])/[Calculation_873909442455048192 1 1]' />
      </column>
      <column caption='YOY Sales%' datatype='real' name='[Calculation_873909442462609409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_873909442455048192]-[Calculation_873909442455048192 1])/[Calculation_873909442455048192 1]' />
      </column>
      <column caption='YOY Quantity Margin' datatype='string' name='[Calculation_873909442465128450 1 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_873909442462609409 1 1] &gt;0 THEN&apos;▲&apos; ELSEIF [Calculation_873909442462609409 1 1]&lt;0 THEN &apos;▼&apos; END' />
      </column>
      <column caption='YOY Profit Margin' datatype='string' name='[Calculation_873909442465128450 1]' role='dimension' type='nominal'>

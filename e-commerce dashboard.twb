      <column caption='PYTD Sales' datatype='real' name='[Calculation_943152286752964613 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(YEAR([Order Date]))}-1 THEN [Sales] END' />
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_943152286752964613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(YEAR([Order Date]))} THEN [Sales] END' />
      </column>
      <column caption='% Difference' datatype='real' name='[Calculation_998039907217326080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_943152286752964613])-SUM([Calculation_943152286752964613 1]))/SUM([Calculation_943152286752964613 1])' />
      </column>
      <column caption='Sales Margin' datatype='string' name='[Calculation_998039907218030593]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_943152286752964613])-SUM([Calculation_943152286752964613 1])&lt;0 THEN &apos;Less than PY&apos;&#10;ELSEIF SUM([Calculation_943152286752964613])-SUM([Calculation_943152286752964613 1])&gt;0 THEN &apos;Greater than PY&apos;&#10;ELSEIF ISNULL(SUM([Calculation_943152286752964613 1])) THEN &apos;No Sales in PY&apos;&#10;END' />
      </column>
      <column caption='Negative% Diff' datatype='string' name='[Calculation_998039907219120130 1]' role='measure' type='nominal'>

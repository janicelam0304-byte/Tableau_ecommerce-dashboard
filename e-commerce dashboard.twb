      <column caption='PYTD Profit LOD' datatype='real' name='[Calculation_873909442455048192 1 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date])={MAX (YEAR([Order Date]))-1} THEN [Profit Per Order] END)}' />
      </column>
      <column caption='PYTD Quantity LOD' datatype='integer' name='[Calculation_873909442455048192 1 2]' role='measure' type='quantitative'>
